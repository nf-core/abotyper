# Local image of abotyper-core 0.4.1 (PyPI) for docker/podman, until the Seqera Containers image is built from its
# Bioconda recipe (in review). Every ABOTYPERCORE_* module uses this tag:
#
#   docker build -t abotyper.local/abotyper-core:0.4.1 -f assets/dev/Dockerfile.abotyper-core .
#
# With -profile conda nothing needs building once Bioconda has 0.4.1 (the module environments are
# bioconda::abotyper-core=0.4.1).
FROM python:3.12-slim
RUN pip install --no-cache-dir abotyper-core==0.4.1 \
    && apt-get update && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*
