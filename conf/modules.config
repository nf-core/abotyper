/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // fastqc
    withName: FASTQC {
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/qc-reports/fastqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // multiqc
    withName: MULTIQC {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/qc-reports/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // minimap2/align - single entry, single combined reference
    withName: MINIMAP2_ALIGN {
        ext.args   = ""
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // samtools/coverage - single entry, single combined reference
    withName: SAMTOOLS_COVERAGE {
        ext.args   = ""
        ext.prefix = {"${meta.id}.coverage"}
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // samtools/flagstat - single entry, single combined reference
    withName: SAMTOOLS_FLAGSTAT {
        ext.args   = ""
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // samtools/stats - single entry, single combined reference
    withName: SAMTOOLS_STATS {
        ext.args   = ""
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // samtools/mpileup replacement
    withName: HAPLOSCAN {
        ext.args   = "--panel ${params.abo_panel}"
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/haploscan" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // predict abo phenotype
		// Extract snps relevant to ABO phenotyping -- no -e/--exon passed:
		// the script auto-detects every exon present via panel position
		// overlap and writes all sections into one combined report.

    // Extract relevant ABO SNPs from haploscan results
    withName: ABO_GETABOSNPS {
        ext.args   = "--panel ${params.abo_panel}"
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Intepret the SNP's into ABO phenotyping
	withName: ABO_SNPS2PHENO {
		ext.args   = "--panel ${params.abo_panel}"
		publishDir = [
			path: { "${params.outdir}" },
			mode: params.publish_dir_mode,
			saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
		]
	}

	// Aggregate snps and compute phenotype and genotype
    withName: PREDICTABOPHENOTYPE {
        ext.args   = ""
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
