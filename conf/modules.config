/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // nanoplot
    withName: 'NANOPLOT' {
        ext.args   = { "--only-report --prefix ${meta.id}_" }
        // NanoPlot exits 1 on a FASTQ with no reads (e.g. a clean negative control); its report only feeds MultiQC
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) && task.attempt <= 1 ? 'retry' : 'ignore' }
        publishDir = [
            path: { "${params.outdir}/qc_and_preprocessing/nanoplot" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // multiqc
    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/qc_and_preprocessing/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // minimap2/align
    withName: MINIMAP2_ALIGN {
        // platform preset (-x): map-ont by default, --minimap2_preset to change it
        ext.args   = { "-x ${params.minimap2_preset}" }
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // samtools/coverage
    withName: SAMTOOLS_COVERAGE {
        ext.args   = ""
        ext.prefix = {"${meta.id}.coverage"}
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // samtools/flagstat
    withName: SAMTOOLS_FLAGSTAT {
        ext.args   = ""
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // samtools/stats
    withName: SAMTOOLS_STATS {
        ext.args   = ""
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Downloaded once and reused across every sample (broadcast as a value channel)
    // don't republish this multi-GB model cache into every run's output directory.
    withName: CLAIR3_DOWNLOADMODEL {
        publishDir = [ enabled: false ]
    }

    // clair3
    withName: CLAIR3 {
        ext.args   = { "--include_all_ctgs --enable_phasing --enable_long_indel --sample_name='${meta.id}' --gvcf" }
        ext.prefix = { "${meta.id}_clair3." }
        // retry once on a resource exit (e.g. out of memory), then fall back to the BAM pileup alone
        errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) && task.attempt <= 1 ? 'retry' : 'ignore' }
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/clair3" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Generate the panel BED (indel/homopolymer rows padded) once per run
    withName: ABOTYPERCORE_PANELTOBED {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Clair3 gVCF -> HAPLOSCAN-format metrics, replacing HAPLOSCAN
    withName: ABOTYPERCORE_CLAIR2METRICS {
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/clair2metrics" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // samtools mpileup over the panel BED. -a keeps zero-depth positions; -B (no BAQ) and
    // -d 0 (no depth cap) suit ONT amplicon data; -Q/-q drop very low base / mapping quality.
    withName: SAMTOOLS_MPILEUP {
        ext.args   = '-a -B -d 0 -Q 7 -q 1'
        publishDir = [ enabled: false ]
    }

    // Combine the Clair3 and BAM-pileup lines of evidence (Clair3 primary, BAM fills gaps)
    // and report their concordance. Its table is the one PREDICTABOPHENOTYPE scores.
    withName: ABOTYPERCORE_PILEUP2METRICS {
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/clair2metrics" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Clair3 phased VCF -> HAPLOSCAN-format Haplotypes.tsv, for PhaseConfidence
    withName: ABOTYPERCORE_CLAIR2HAPLOTYPES {
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/clair2metrics" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Left-align indels / split multiallelics on Clair3's PASS-filtered calls
    // (QC/export chain -- ABOTYPERCORE_CLAIR2METRICS reads the gVCF directly for scoring)
    withName: BCFTOOLS_NORM {
        ext.args   = '-m -any --output-type z --write-index=tbi'
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/clair3" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Restrict normalized calls to the ABO panel positions
    withName: BCFTOOLS_VIEW {
        ext.args   = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.panel" }
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/clair3" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Flatten panel-filtered calls to a per-position TSV
    withName: BCFTOOLS_QUERY {
        ext.args   = { "-f '%CHROM\\t%POS\\t%REF\\t%ALT[\\t%GT\\t%AD\\t%DP]\\n'" }
        ext.prefix = { "${meta.id}.panel" }
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/clair3" },
            mode: params.publish_dir_mode,
            // the module writes <prefix>.txt; it is a tab-separated table, published as .tsv
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.replaceAll(/\.txt$/, '.tsv') }
        ]
    }

    // ABOTYPERCORE_PREDICTPHENOTYPE: ABO phenotype from each sample's per-position metrics. No exon is passed:
    // abotyper-predict-phenotype finds every exon present from the panel positions and writes one combined report.
    withName: ABOTYPERCORE_PREDICTPHENOTYPE {
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ABOTYPERCORE_AGGREGATE: the run's result tables (ABO_result.txt/.xlsx, final_export.csv, run QC report)
    withName: ABOTYPERCORE_AGGREGATE {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
