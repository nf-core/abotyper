/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // nanoplot
    withName: 'NANOPLOT' {
        // Output files are prefixed with the sample id, e.g. <meta.id>_NanoPlot-report.html
        ext.args   = { "--only-report --prefix ${meta.id}_" }
        // Only the HTML report is published; <meta.id>_NanoStats.txt is still passed to MultiQC
        publishDir = [
            path: { "${params.outdir}/qc_and_preprocessing/nanoplot" },
            mode: params.publish_dir_mode,
            pattern: '*NanoPlot-report.html'
        ]
    }

    // multiqc
    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/qc_and_preprocessing/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // minimap2/aligne
    withName: MINIMAP2_ALIGN {
        ext.args   = ""
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // samtools/coveragee
    withName: SAMTOOLS_COVERAGE {
        ext.args   = ""
        ext.prefix = {"${meta.id}.coverage"}
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // samtools/flagstate
    withName: SAMTOOLS_FLAGSTAT {
        ext.args   = ""
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // samtools/statse
    withName: SAMTOOLS_STATS {
        ext.args   = ""
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Downloaded once and reused across every sample (broadcast as a value channel)
    // don't republish this multi-GB model cache into every run's output directory.
    withName: DOWNLOAD_CLAIR3_MODEL {
        publishDir = [ enabled: false ]
    }

    // clair3
    withName: CLAIR3 {
        ext.args   = { "--include_all_ctgs --enable_phasing --enable_long_indel --sample_name='${meta.id}' --gvcf" }
        ext.prefix = { "${meta.id}_clair3." }
        errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/clair3" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Generate the panel BED (indel/homopolymer rows padded) once per run
    withName: ABO_PANEL2BED {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Clair3 gVCF -> HAPLOSCAN-format metrics, replacing HAPLOSCAN
    withName: ABO_CLAIR2METRICS {
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/clair2metrics" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Clair3 phased VCF -> HAPLOSCAN-format Haplotypes.tsv, for PhaseConfidence
    withName: ABO_CLAIR2HAPLOTYPES {
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/clair2metrics" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Left-align indels / split multiallelics on Clair3's PASS-filtered calls
    // (QC/export chain -- ABO_CLAIR2METRICS reads the gVCF directly for scoring)
    withName: BCFTOOLS_NORM {
        ext.args   = '-m -any --output-type z --write-index=tbi'
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/clair3" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Restrict normalized calls to the ABO panel positions
    withName: BCFTOOLS_VIEW {
        ext.args   = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.panel." }
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/clair3" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Flatten panel-filtered calls to a per-position TSV
    withName: BCFTOOLS_QUERY {
        ext.args   = { "-f '%CHROM\\t%POS\\t%REF\\t%ALT[\\t%GT\\t%AD\\t%DP]\\n'" }
        ext.suffix = 'tsv'
        ext.prefix = { "${meta.id}.panel." }
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}/clair3" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // predict abo phenotype
		// Extract snps relevant to ABO phenotyping -- no -e/--exon passed:
		// the script auto-detects every exon present via panel position
		// overlap and writes all sections into one combined report.

    // Extract relevant ABO SNPs from ABO_CLAIR2METRICS results
    withName: ABO_GETABOSNPS {
        ext.args   = "--panel ${params.abo_panel}"
        publishDir = [
            path: { "${params.outdir}/per_sample_processing/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Intepret the SNP's into ABO phenotyping
	withName: ABO_SNPS2PHENO {
		ext.args   = "--panel ${params.abo_panel}"
		publishDir = [
			path: { "${params.outdir}" },
			mode: params.publish_dir_mode,
			saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
		]
	}

	// Aggregate snps and compute phenotype and genotype
    withName: PREDICTABOPHENOTYPE {
        ext.args   = ""
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
