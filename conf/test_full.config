/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/abotyper -profile test_full,<docker/singularity> --outdir <OUTDIR>

    The full-size test uses the same ten samples as -profile test (one sample of each common
    ABO genotype, nf-core/test-datasets branch abotyper). There is no larger public dataset:
    ABO amplicon reads are human genetic data, and the donor runs used to validate the pipeline
    cannot be published. The test reads are simulated (100 to 200 reads per sample) from ISBT ABO
    allele sequences of the exon 2-7 amplicon on NG_006669.2, with nanopore-like errors; how they
    were made is described in the README of the test-data branch. The test runs every step of the
    analysis; a production run differs in the number of samples and reads.
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    input = params.pipelines_testdata_base_path + 'abotyper/abotyper/samplesheet_test_abotyper.csv'
}
