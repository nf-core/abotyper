/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/abotyper -profile test_full,<docker/singularity> --outdir <OUTDIR>

    The full-size test uses the same ten samples as -profile test (one library of each common
    ABO genotype, nf-core/test-datasets branch abotyper). There is no larger public dataset:
    ABO amplicon reads are human genetic data, and the donor runs used to validate the pipeline
    cannot be published. The test samples are whole libraries from a real run, not downsampled
    (67 to 198 reads each, spanning the exon 2-7 amplicon), so the test runs every step of the
    analysis on real data; a production run differs in the number of samples and reads.
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    input = params.pipelines_testdata_base_path + 'abotyper/abotyper/samplesheet_test_abotyper.csv'
}
