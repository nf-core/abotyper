nextflow_process {

    name "Test Process ABO_CLAIR2HAPLOTYPES"
    script "../main.nf"
    process "ABO_CLAIR2HAPLOTYPES"

    tag "modules"
    tag "modules_local"
    tag "abo/clair2haplotypes"
    tag "abotyper"

    test("abotyper - ABO_AA_barcode01 - phased VCF -> haplotypes") {

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AA_barcode01' ],
                    file("$projectDir/tests/fixtures/ABO_AA_barcode01/ABO_AA_barcode01_clair3.phased_merge_output.vcf.gz", checkIfExists: true)
                ]
                input[1] = file("$projectDir/assets/refs/abo_variant_panel.yaml", checkIfExists: true)
                """
            }
        }

        then {
            def lines = path(process.out.tsv[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert process.out.tsv[0][1] ==~ ".*/ABO_AA_barcode01.Haplotypes.tsv" },
                { assert lines.size() > 1 },
                { assert snapshot(
                    process.out.tsv,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("abotyper - ABO_AA_barcode01 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AA_barcode01' ],
                    file("$projectDir/tests/fixtures/ABO_AA_barcode01/ABO_AA_barcode01_clair3.phased_merge_output.vcf.gz", checkIfExists: true)
                ]
                input[1] = file("$projectDir/assets/refs/abo_variant_panel.yaml", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
