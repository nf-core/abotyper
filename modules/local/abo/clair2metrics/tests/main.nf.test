nextflow_process {

    name "Test Process ABO_CLAIR2METRICS"
    script "../main.nf"
    process "ABO_CLAIR2METRICS"

    tag "modules"
    tag "modules_local"
    tag "abo/clair2metrics"
    tag "abotyper"

    test("abotyper - ABO_AA_barcode01 - Clair3 gVCF -> metrics") {

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AA_barcode01' ],
                    file("$projectDir/tests/fixtures/ABO_AA_barcode01/ABO_AA_barcode01_clair3.merge_output.gvcf.gz", checkIfExists: true)
                ]
                input[1] = file("$projectDir/assets/refs/abo_variant_panel.yaml", checkIfExists: true)
                """
            }
        }

        then {
            def lines = path(process.out.tsv[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert process.out.tsv[0][1] ==~ ".*/ABO_AA_barcode01.AlignmentStatistics.tsv" },
                { assert lines[0].startsWith("Ref_Position_1based\tRef_Base\tMatch_Percent") },
                // header + one row per calibrated panel position
                { assert lines.size() == 52 },
                // the fixture was called over the ABO region: every panel position has depth
                { assert lines.drop(1).every { it.split('\t')[10].toInteger() > 0 } },
                { assert snapshot(
                    process.out.tsv,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("abotyper - ABO_AA_barcode01 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AA_barcode01' ],
                    file("$projectDir/tests/fixtures/ABO_AA_barcode01/ABO_AA_barcode01_clair3.merge_output.gvcf.gz", checkIfExists: true)
                ]
                input[1] = file("$projectDir/assets/refs/abo_variant_panel.yaml", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
