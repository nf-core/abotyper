nextflow_process {

    name "Test Process ABO_GETABOSNPS"
    script "../main.nf"
    process "ABO_GETABOSNPS"

    tag "modules"
    tag "modules_local"
    tag "abo/getabosnps"
    tag "abotyper"

    // Single combined-reference layout: one metrics table per sample covers every exon,
    // so there is no per-exon meta or input any more.

    test("abotyper - ABO_AA_barcode01 - metrics + coverage -> ABOPhenotype report") {

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AA_barcode01' ],
                    file("$projectDir/tests/fixtures/ABO_AA_barcode01/ABO_AA_barcode01.merged.AlignmentStatistics.tsv", checkIfExists: true),
                    file("$projectDir/tests/fixtures/ABO_AA_barcode01/ABO_AA_barcode01.coverage.txt", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def report = path(process.out.phenotype[0][1]).text
            assertAll(
                { assert process.success },
                { assert process.out.phenotype[0][1] ==~ ".*/ABO_AA_barcode01.ABOPhenotype.txt" },
                { assert process.out.log[0][1] ==~ ".*/ABO_AA_barcode01.log.txt" },
                // one report covers every exon section of the combined reference
                { assert report.contains("Exon 6:") && report.contains("Exon 7:") },
                // c.261delG (position 22694) is a primary position and must be reported
                { assert report.contains("Position:22694") },
                { assert report.contains("Aligned Read Count:") },
                { assert snapshot(
                    process.out.phenotype,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("abotyper - ABO_AA_barcode01 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AA_barcode01' ],
                    file("$projectDir/tests/fixtures/ABO_AA_barcode01/ABO_AA_barcode01.merged.AlignmentStatistics.tsv", checkIfExists: true),
                    file("$projectDir/tests/fixtures/ABO_AA_barcode01/ABO_AA_barcode01.coverage.txt", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
