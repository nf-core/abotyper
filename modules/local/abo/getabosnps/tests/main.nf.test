nextflow_process {

    name "Test Process ABO_GETABOSNPS"
    script "../main.nf"
    process "ABO_GETABOSNPS"

    tag "modules"
    tag "modules_local"
    tag "abo/getabosnps"
    tag "abotyper"

    test("abotyper - ABO_AA_barcode01 - exon6") {

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AA_barcode01', exon:'exon6' ],
                    file(params.pipelines_testdata_base_path + 'abotyper/abotyper/per_sample_processing/ABO_AA_barcode01/exon6/haploscan/ABO_AA_barcode01.AlignmentStatistics.tsv', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + 'abotyper/abotyper/per_sample_processing/ABO_AA_barcode01/exon6/alignment/ABO_AA_barcode01.coverage.txt', checkIfExists: true),
                    'exon6'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.phenotype[0][1] ==~ ".*/ABO_AA_barcode01.ABOPhenotype.txt" },
                { assert process.out.log[0][1] ==~ ".*/ABO_AA_barcode01.log.txt" },
                { assert path(process.out.phenotype[0][1]).exists() },
                { assert path(process.out.log[0][1]).exists() },
                { assert path(process.out.phenotype[0][1]).text.size() > 0 },
                { assert path(process.out.log[0][1]).text.size() > 0 },
                { assert path(process.out.log[0][1]).text.contains("exon6") || path(process.out.log[0][1]).text.contains("ABO_AA_barcode01") },
                { assert snapshot(
                    path(process.out.phenotype[0][1]).readLines()[0..2],
                    process.out.versions
                ).match("ABO_AA_barcode01_exon6") }
            )
        }
    }

