nextflow_process {

    name "Test Process ABO_PANEL2BED"
    script "../main.nf"
    process "ABO_PANEL2BED"

    tag "modules"
    tag "modules_local"
    tag "abo/panel2bed"
    tag "abotyper"

    test("abotyper - panel yaml -> BED") {

        when {
            process {
                """
                input[0] = file("$projectDir/assets/refs/abo_variant_panel.yaml", checkIfExists: true)
                """
            }
        }

        then {
            def bed = path(process.out.bed[0])
            assertAll(
                { assert process.success },
                // one interval per calibrated panel position (51 in the shipped panel)
                { assert bed.readLines().size() == 51 },
                // 4 columns: chrom, start, end, id; chrom is the NG_006669.2 reference
                { assert bed.readLines().every { it.split('\t').size() == 4 && it.startsWith('NG_006669.2\t') } },
                { assert snapshot(bed, process.out.findAll { key, val -> key.startsWith('versions') }).match() }
            )
        }
    }

    test("abotyper - panel yaml -> BED - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file("$projectDir/assets/refs/abo_variant_panel.yaml", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
