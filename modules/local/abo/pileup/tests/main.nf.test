nextflow_process {

    name "Test Process ABO_PILEUP"
    script "../main.nf"
    process "ABO_PILEUP"

    tag "modules"
    tag "modules_local"
    tag "abo/pileup"
    tag "abotyper"

    test("abotyper - ABO_AA_barcode01 - BAM pileup over the panel BED") {

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AA_barcode01' ],
                    file("$projectDir/tests/fixtures/ABO_AA_barcode01/ABO_AA_barcode01.bam", checkIfExists: true),
                    file("$projectDir/tests/fixtures/ABO_AA_barcode01/ABO_AA_barcode01.bam.bai", checkIfExists: true)
                ]
                input[1] = [
                    [ id:'NG_006669v2' ],
                    file("$projectDir/assets/refs/NG_006669v2.fasta", checkIfExists: true),
                    file("$projectDir/assets/refs/NG_006669v2.fasta.fai", checkIfExists: true)
                ]
                input[2] = file("$projectDir/assets/refs/abo_variant_panel.bed", checkIfExists: true)
                """
            }
        }

        then {
            def lines = path(process.out.pileup[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert process.out.pileup[0][1] ==~ ".*/ABO_AA_barcode01.pileup.txt" },
                // -a keeps every BED position, including zero-depth ones; six mpileup columns
                { assert lines.size() > 0 },
                { assert lines.every { it.split('\t').size() >= 5 && it.startsWith('NG_006669.2\t') } },
                // the test BAM covers the whole panel: depth (column 4) is non-zero at c.261delG (22694)
                { assert lines.find { it.split('\t')[1] == '22694' }.split('\t')[3].toInteger() > 0 },
                { assert snapshot(
                    process.out.pileup,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("abotyper - ABO_AA_barcode01 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AA_barcode01' ],
                    file("$projectDir/tests/fixtures/ABO_AA_barcode01/ABO_AA_barcode01.bam", checkIfExists: true),
                    file("$projectDir/tests/fixtures/ABO_AA_barcode01/ABO_AA_barcode01.bam.bai", checkIfExists: true)
                ]
                input[1] = [
                    [ id:'NG_006669v2' ],
                    file("$projectDir/assets/refs/NG_006669v2.fasta", checkIfExists: true),
                    file("$projectDir/assets/refs/NG_006669v2.fasta.fai", checkIfExists: true)
                ]
                input[2] = file("$projectDir/assets/refs/abo_variant_panel.bed", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
