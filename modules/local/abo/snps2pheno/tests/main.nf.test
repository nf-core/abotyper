nextflow_process {

    name "Test Process ABO_SNPS2PHENO"
    script "../main.nf"
    process "ABO_SNPS2PHENO"

    tag "modules"
    tag "modules_local"
    tag "abo/snps2pheno"
    tag "abotyper"

    // Two samples in the per_sample_processing/<id>/combined/ layout the subworkflow publishes:
    // ABO_AA_barcode01 (AA) and ABO_BO1_barcode06 (BO). As in the pipeline, input 0 is the list of
    // sample folders and input 1 the per_sample_processing folder the script scans; their staged
    // names differ, so there is no input name collision.

    test("abotyper - two samples compiled into the final tables") {

        when {
            process {
                """
                input[0] = [
                    file("$projectDir/tests/fixtures/per_sample_processing/ABO_AA_barcode01", checkIfExists: true),
                    file("$projectDir/tests/fixtures/per_sample_processing/ABO_BO1_barcode06", checkIfExists: true)
                ]
                input[1] = file("$projectDir/tests/fixtures/per_sample_processing", checkIfExists: true)
                """
            }
        }

        then {
            def csv = path(process.out.csv[0]).readLines()
            assertAll(
                { assert process.success },
                { assert process.out.txt[0] ==~ ".*/ABO_result.txt" },
                { assert process.out.xls[0] ==~ ".*/ABO_result.xlsx" },
                { assert process.out.csv[0] ==~ ".*/final_export.csv" },
                { assert path(process.out.xls[0]).exists() },
                // header + one row per sample
                { assert csv.size() == 3 },
                { assert csv.any { it.contains("ABO_AA") } && csv.any { it.contains("ABO_BO1") } },
                // genotypes of the two fixtures
                { assert path(process.out.txt[0]).text.contains("AA") && path(process.out.txt[0]).text.contains("BO") },
                // the run-level QC report and the MultiQC evidence table are emitted
                { assert path(process.out.qc[0]).text.contains("RESEARCH USE ONLY") },
                { assert path(process.out.mqc[0]).text.contains("abo_evidence_summary") },
                { assert snapshot(
                    process.out.csv,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("abotyper - two samples compiled - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    file("$projectDir/tests/fixtures/per_sample_processing/ABO_AA_barcode01", checkIfExists: true),
                    file("$projectDir/tests/fixtures/per_sample_processing/ABO_BO1_barcode06", checkIfExists: true)
                ]
                input[1] = file("$projectDir/tests/fixtures/per_sample_processing", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
