nextflow_process {

    name "Test Process ABO_SNPS2PHENO"
    script "../main.nf"
    process "ABO_SNPS2PHENO"

    tag "modules"
    tag "modules_local"
    tag "abo/snps2pheno"
    tag "abotyper"

    // Two samples, ABO_AA_barcode01 (AA) and ABO_BO1_barcode06 (BO). As in the pipeline, input 0 is
    // the list of sample IDs and input 1 every per-sample file (<id>.<suffix>); the module builds the
    // per_sample_processing/<id>/combined/ layout inside the task. No sample table (input 2).

    test("abotyper - two samples compiled into the final tables") {

        when {
            process {
                """
                input[0] = [ 'ABO_AA_barcode01', 'ABO_BO1_barcode06' ]
                input[1] = [ 'ABO_AA_barcode01', 'ABO_BO1_barcode06' ].collectMany { id ->
                    file("$projectDir/tests/fixtures/per_sample_processing/\${id}/combined", checkIfExists: true).listFiles().toList()
                }
                input[2] = []
                input[3] = []  // panel bundled with abotyper-core
                """
            }
        }

        then {
            def csv = path(process.out.csv[0]).readLines()
            assertAll(
                { assert process.success },
                { assert process.out.txt[0] ==~ ".*/ABO_result.txt" },
                { assert process.out.xls[0] ==~ ".*/ABO_result.xlsx" },
                { assert process.out.csv[0] ==~ ".*/final_export.csv" },
                { assert path(process.out.xls[0]).exists() },
                // header + one row per sample
                { assert csv.size() == 3 },
                { assert csv.any { it.contains("ABO_AA") } && csv.any { it.contains("ABO_BO1") } },
                // genotypes of the two fixtures
                { assert path(process.out.txt[0]).text.contains("AA") && path(process.out.txt[0]).text.contains("BO") },
                // the run-level QC report and the MultiQC evidence table are emitted
                { assert path(process.out.qc[0]).text.contains("RESEARCH USE ONLY") },
                { assert path(process.out.mqc[0]).text.contains("abo_evidence_summary") },
                { assert snapshot(
                    process.out.csv,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("abotyper - declared negative control with reads is flagged") {

        // ABO_AA_barcode01 is declared a negative control in the sample table; it has ABO reads,
        // so the run QC must report possible contamination. Without the declaration it is a sample.
        when {
            process {
                """
                input[0] = [ 'ABO_AA_barcode01', 'ABO_BO1_barcode06' ]
                input[1] = [ 'ABO_AA_barcode01', 'ABO_BO1_barcode06' ].collectMany { id ->
                    file("$projectDir/tests/fixtures/per_sample_processing/\${id}/combined", checkIfExists: true).listFiles().toList()
                }
                input[2] = file("$projectDir/tests/fixtures/controls_AA_negative.tsv", checkIfExists: true)
                input[3] = []  // panel bundled with abotyper-core
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert (path(process.out.txt[0]).text + path(process.out.qc[0]).text).contains("possible contamination") }
            )
        }
    }

    test("abotyper - sample name and barcode from the sample table") {

        // The sample table (from the samplesheet) names ABO_AA_barcode01 "DonorA" on barcode 11; the
        // other row is empty, so ABO_BO1_barcode06 is still split from its ID (ABO_BO1, barcode06).
        when {
            process {
                """
                input[0] = [ 'ABO_AA_barcode01', 'ABO_BO1_barcode06' ]
                input[1] = [ 'ABO_AA_barcode01', 'ABO_BO1_barcode06' ].collectMany { id ->
                    file("$projectDir/tests/fixtures/per_sample_processing/\${id}/combined", checkIfExists: true).listFiles().toList()
                }
                input[2] = file("$projectDir/tests/fixtures/samples_named.tsv", checkIfExists: true)
                input[3] = []  // panel bundled with abotyper-core
                """
            }
        }

        then {
            def csv = path(process.out.csv[0]).readLines()
            assertAll(
                { assert process.success },
                { assert csv.size() == 3 },
                { assert csv.any { it.startsWith("DonorA,") } },
                { assert csv.any { it.startsWith("ABO_BO1,") } },
                // the Barcode column of ABO_result.txt (tab-separated, after Sequencing_ID)
                { assert path(process.out.txt[0]).readLines().any { it.split("\t").toList().take(3).containsAll(["DonorA", "11"]) } }
            )
        }
    }

    test("abotyper - any sample name is reported") {

        // The two fixtures under names the aggregation used to drop or crash on.
        when {
            process {
                """
                def renamed = [ 'ABO_AA_barcode01': 'patient-01', 'ABO_BO1_barcode06': 'X_barcode06_rep2' ]
                def staged = []
                renamed.each { old_id, new_id ->
                    file("$projectDir/tests/fixtures/per_sample_processing/\${old_id}/combined", checkIfExists: true).listFiles().each { f ->
                        def dest = file("$outputDir/renamed/\${f.name.replace(old_id, new_id)}")
                        dest.parent.mkdirs()
                        f.copyTo(dest)
                        staged << dest
                    }
                }
                input[0] = renamed.values() as List
                input[1] = staged
                input[2] = []
                input[3] = []  // panel bundled with abotyper-core
                """
            }
        }

        then {
            def csv = path(process.out.csv[0]).readLines()
            assertAll(
                { assert process.success },
                // header + one row per sample, under the names given
                { assert csv.size() == 3 },
                { assert csv.any { it.startsWith("patient-01,") } },
                { assert csv.any { it.startsWith("X_barcode06_rep2,") } }
            )
        }
    }

    test("abotyper - two samples compiled - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ 'ABO_AA_barcode01', 'ABO_BO1_barcode06' ]
                input[1] = [ 'ABO_AA_barcode01', 'ABO_BO1_barcode06' ].collectMany { id ->
                    file("$projectDir/tests/fixtures/per_sample_processing/\${id}/combined", checkIfExists: true).listFiles().toList()
                }
                input[2] = []
                input[3] = []  // panel bundled with abotyper-core
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
