nextflow_process {

    name "Test Process ABOTYPERCORE_CLAIR2HAPLOTYPES"
    script "../main.nf"
    process "ABOTYPERCORE_CLAIR2HAPLOTYPES"

    tag "modules"
    tag "modules_local"
    tag "abotypercore/clair2haplotypes"
    tag "abotyper"

    test("abotyper - ABO_AB_barcode02 - phased VCF -> haplotypes") {

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AB_barcode02' ],
                    file("\${params.pipelines_testdata_base_path}abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/clair3/ABO_AB_barcode02_clair3.phased_merge_output.vcf.gz", checkIfExists: true)
                ]
                input[1] = []  // panel bundled with abotyper-core
                """
            }
        }

        then {
            def lines = path(process.out.tsv[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert process.out.tsv[0][1] ==~ ".*/ABO_AB_barcode02.Haplotypes.tsv" },
                { assert lines.size() > 1 },
                { assert snapshot(
                    process.out.tsv,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("abotyper - ABO_AB_barcode02 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AB_barcode02' ],
                    file("\${params.pipelines_testdata_base_path}abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/clair3/ABO_AB_barcode02_clair3.phased_merge_output.vcf.gz", checkIfExists: true)
                ]
                input[1] = []  // panel bundled with abotyper-core
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
