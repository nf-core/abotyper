nextflow_process {

    name "Test Process ABOTYPERCORE_PILEUP2METRICS"
    script "../main.nf"
    process "ABOTYPERCORE_PILEUP2METRICS"

    tag "modules"
    tag "modules_local"
    tag "abotypercore/pileup2metrics"
    tag "abotyper"

    test("abotyper - ABO_AB_barcode02 - Clair3 + BAM pileup agree") {

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AB_barcode02' ],
                    file("\${params.pipelines_testdata_base_path}abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/mpileup/ABO_AB_barcode02.mpileup.gz", checkIfExists: true),
                    file("\${params.pipelines_testdata_base_path}abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/clair2metrics/ABO_AB_barcode02.clair3.AlignmentStatistics.tsv", checkIfExists: true)
                ]
                input[1] = []  // panel bundled with abotyper-core
                """
            }
        }

        then {
            def status = path(process.out.status[0][1]).readLines()
            def row    = [status[0].split('\t'), status[1].split('\t')].transpose().collectEntries { k, v -> [k, v] }
            assertAll(
                { assert process.success },
                // the merged table keeps its name; the Clair3 input is staged in clair3/ so they do not collide
                { assert process.out.tsv[0][1] ==~ ".*/ABO_AB_barcode02.AlignmentStatistics.tsv" },
                // header + one row per calibrated panel position (135 in panel v2.3.0)
                { assert path(process.out.tsv[0][1]).readLines().size() == 136 },
                { assert row.positions == '135' },
                { assert row.evidence_source == 'CLAIR3+BAM' },
                // the simulated exon 2-7 reads cover every panel position, in both lines of evidence
                { assert row.both == '135' },
                { assert row.clair3_only == '0' },
                // at most one non-primary position may disagree (simulated reads carry indel noise in homopolymer runs)
                { assert row.discordant.toInteger() <= 1 },
                { assert row.discordant_primary == '0' },
                { assert snapshot(
                    process.out.tsv,
                    process.out.status,
                    process.out.concordance,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("abotyper - ABO_AB_barcode02 - Clair3 produced nothing (BAM pileup only)") {

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AB_barcode02' ],
                    file("\${params.pipelines_testdata_base_path}abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/mpileup/ABO_AB_barcode02.mpileup.gz", checkIfExists: true),
                    []
                ]
                input[1] = []  // panel bundled with abotyper-core
                """
            }
        }

        then {
            def status = path(process.out.status[0][1]).readLines()
            def row    = [status[0].split('\t'), status[1].split('\t')].transpose().collectEntries { k, v -> [k, v] }
            assertAll(
                { assert process.success },
                { assert row.evidence_source == 'BAM_ONLY' },
                // the pileup alone covers every panel position
                { assert row.bam_only == '135' },
                { assert row.clair3_only == '0' },
                { assert path(process.out.tsv[0][1]).readLines().size() == 136 },
                { assert snapshot(process.out.tsv, process.out.status).match() }
            )
        }
    }

    test("abotyper - ABO_AB_barcode02 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AB_barcode02' ],
                    file("\${params.pipelines_testdata_base_path}abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/mpileup/ABO_AB_barcode02.mpileup.gz", checkIfExists: true),
                    file("\${params.pipelines_testdata_base_path}abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/clair2metrics/ABO_AB_barcode02.clair3.AlignmentStatistics.tsv", checkIfExists: true)
                ]
                input[1] = []  // panel bundled with abotyper-core
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
