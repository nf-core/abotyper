nextflow_process {

    name "Test Process ABOTYPERCORE_PREDICTPHENOTYPE"
    script "../main.nf"
    process "ABOTYPERCORE_PREDICTPHENOTYPE"

    tag "modules"
    tag "modules_local"
    tag "abotypercore/predictphenotype"
    tag "abotyper"

    // Single combined-reference layout: one metrics table per sample covers every exon,
    // so there is no per-exon meta or input any more.

    test("abotyper - ABO_AB_barcode02 - metrics + coverage -> ABOPhenotype report") {

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AB_barcode02' ],
                    file("\${params.pipelines_testdata_base_path}abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/clair2metrics/ABO_AB_barcode02.AlignmentStatistics.tsv", checkIfExists: true),
                    file("\${params.pipelines_testdata_base_path}abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/alignment/ABO_AB_barcode02.coverage.txt", checkIfExists: true)
                ]
                input[1] = []  // panel bundled with abotyper-core
                """
            }
        }

        then {
            def report = path(process.out.phenotype[0][1]).text
            assertAll(
                { assert process.success },
                { assert process.out.phenotype[0][1] ==~ ".*/ABO_AB_barcode02.ABOPhenotype.txt" },
                { assert process.out.log[0][1] ==~ ".*/ABO_AB_barcode02.log.txt" },
                // one report covers every exon section of the combined reference
                { assert report.contains("Exon 6:") && report.contains("Exon 7:") },
                // c.261delG (position 22694) is a primary position and must be reported
                { assert report.contains("Position:22694") },
                { assert report.contains("Aligned Read Count:") },
                { assert snapshot(
                    process.out.phenotype,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("abotyper - ABO_AB_barcode02 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AB_barcode02' ],
                    file("\${params.pipelines_testdata_base_path}abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/clair2metrics/ABO_AB_barcode02.AlignmentStatistics.tsv", checkIfExists: true),
                    file("\${params.pipelines_testdata_base_path}abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/alignment/ABO_AB_barcode02.coverage.txt", checkIfExists: true)
                ]
                input[1] = []  // panel bundled with abotyper-core
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
