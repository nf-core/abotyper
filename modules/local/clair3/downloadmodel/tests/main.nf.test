nextflow_process {

    name "Test Process CLAIR3_DOWNLOADMODEL"
    script "../main.nf"
    process "CLAIR3_DOWNLOADMODEL"

    tag "modules"
    tag "modules_local"
    tag "clair3/downloadmodel"
    tag "abotyper"

    // The real model is ~100 MB from the HKU server; the full pipeline test downloads it,
    // so the module test checks the wiring and outputs in stub mode only.

    test("clair3 model url - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = 'https://www.bio8.cs.hku.hk/clair3/clair3_models_pytorch/r1041_e82_400bps_sup_v500/'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.model_dir[0]).resolve('pileup.pt').exists() },
                { assert path(process.out.model_dir[0]).resolve('full_alignment.pt').exists() },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
