/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// Additional parameters for the tests
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/abotyper/'
}

// Cap every task well inside a small test host: conf/test.config allows 15.GB, which a 16 GB machine
// cannot offer (process_high modules then fail with "requirement exceeds available memory")
process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true
