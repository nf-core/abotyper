/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// TODO nf-core: Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/abotyper'
}

    // Default output directory for tests
    outdir = 'test_results'
}

// Resource limits for all tests
process {
    resourceLimits = [
        cpus: 2,
        memory: '3.GB',
        time: '2.h'
    ]
}

// Enable Docker for all tests
docker {
    enabled = true
    // Remove Unix-specific user mapping for Windows compatibility
    // Add network timeout settings
    registry = 'docker.io'
}

// AWS settings with increased timeouts
aws {
    client {
        anonymous = true
        connectionTimeout = 300000  // 5 minutes
        socketTimeout = 300000      // 5 minutes
        maxConnections = 20
        maxErrorRetry = 3
    }
}

// HTTP client settings for better connectivity
env {
    NXF_OPTS = '-Dhttp.socketTimeout=300000 -Dhttp.connectionTimeout=300000'
}

// Anonymous AWS access for public test data
aws.client.anonymous = true
